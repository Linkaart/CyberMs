# DATABASE_URL example: postgresql://user:password@localhost:5432/vulntrack
DATABASE_URL=postgresql://postgres:postgres@db:5432/vulntrack

# JWT secrets (change before prod)
JWT_ACCESS_TOKEN_SECRET=YOUR_JWT_ACCESS_SECRET_HERE
JWT_REFRESH_TOKEN_SECRET=YOUR_JWT_REFRESH_SECRET_HERE
JWT_ACCESS_TOKEN_EXPIRES=15m
JWT_REFRESH_TOKEN_EXPIRES=7d

# Bcrypt cost factor (salt rounds)
BCRYPT_SALT_ROUNDS=12

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
